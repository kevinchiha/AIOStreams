# ─── AI Search (self-hosted) — server env ────────────────────────────────────
# Copy to `.env` (gitignored) on the VPS and `chmod 600`. The server itself holds
# NO provider API keys — OpenRouter / TMDB / Gemini keys are entered per-user at
# /configure and encrypted into the install URL. Only the vars below are read by
# server.js.

# REQUIRED. Master key that encrypts each user's config into their install URL.
# Must be >= 32 chars. Generate ONCE and NEVER change it — rotating this key
# invalidates every existing install URL (everyone would have to reconfigure).
#   openssl rand -hex 32
ENCRYPTION_KEY=

# STRONGLY RECOMMENDED. Public hostname WITHOUT protocol. The app builds the
# manifest / install URLs as https://<HOST>/... — set this so URLs point at the
# box, not localhost. (TLS is terminated at nginx; the app speaks plain HTTP.)
HOST=aisearch.kevbox.dev

# ── Optional ─────────────────────────────────────────────────────────────────
# Trakt personalization ("recommend based on my Trakt"). Register an app at
# https://trakt.tv/oauth/applications (redirect https://<HOST>/...). Leave blank
# to disable. Enabling Trakt is the ONLY reason to mount a data volume (so OAuth
# tokens survive restarts) — see compose.aisearch.yaml.
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Server-level RatingPosterDB fallback (users can also set their own per-config).
# RPDB_API_KEY=

# Gates the cache-management / admin endpoints. Set a random token to lock them.
#   openssl rand -hex 24
# ADMIN_TOKEN=

# Verbose request logging (true/false). Default false.
# ENABLE_LOGGING=false
